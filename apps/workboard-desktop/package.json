{
  "name": "@agent-workboard/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "generate": "cargo run -q --manifest-path src-tauri/Cargo.toml --bin generate-contracts -- write",
    "generate:check": "cargo run -q --manifest-path src-tauri/Cargo.toml --bin generate-contracts -- check",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude '**/*.browser.test.tsx' && vitest run --config vitest.browser.config.ts",
    "app": "tauri build --no-bundle",
    "app:dev": "tauri dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.39.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser": "^3.2.7",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1"
  }
}
