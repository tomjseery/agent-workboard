{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Workboard",
  "version": "0.1.0",
  "identifier": "dev.agentworkboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Agent Workboard",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "devtools": false
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
